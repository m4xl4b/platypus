{
  "name": "platypus",
  "productName": "Platypus",
  "version": "2.10.0",
  "description": "Pixel-art 80s office that shows your Claude Code sessions, agents and subagents in real time.",
  "main": "src/main.js",
  "desktopName": "platypus.desktop",
  "author": "Massimiliano Pane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4xl4b/platypus.git"
  },
  "scripts": {
    "start": "node scripts/launch.js",
    "start:demo": "node scripts/launch.js --demo",
    "web": "node scripts/launch.js --web",
    "web:demo": "node scripts/launch.js --web --demo",
    "electron": "electron .",
    "shortcut": "node scripts/launch.js --shortcut",
    "hooks:install": "node src/hooks-cli.js install",
    "hooks:uninstall": "node src/hooks-cli.js uninstall",
    "hooks:status": "node src/hooks-cli.js status",
    "test": "node scripts/smoke-test.js",
    "i18n:check": "node scripts/i18n-check.js",
    "dist:win": "npm run dist:tools && electron-builder --win zip --x64",
    "dist:mac": "npm run dist:tools && electron-builder --mac zip",
    "dist:linux": "npm run dist:tools && electron-builder --linux AppImage",
    "dist:tools": "npm install --no-save electron-builder@26.18.0 resedit@3.1.0"
  },
  "devDependencies": {
    "electron": "44.9.3"
  },
  "build": {
    "appId": "com.platypus.desktop",
    "productName": "Platypus",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Platypus-${version}-win-x64.${ext}"
    },
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "artifactName": "Platypus-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "Platypus-${version}-linux-${arch}.${ext}"
    }
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
